# =============================================================
#  Travel Planner Agent — .gitignore
# =============================================================

# Environment variables and secrets — NEVER commit these
.env
.env.*
!.env.example

# Dependencies — install with: npm install
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Operating system files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Bob AI assistant workspace
.bob/
