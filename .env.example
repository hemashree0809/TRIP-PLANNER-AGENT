# =============================================================
#  Travel Planner Agent — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit the .env file to version control.
# =============================================================

# -----------------------------------------------------------
# IBM watsonx.ai (Granite LLM)  — REQUIRED
# 1. Sign up at https://cloud.ibm.com/ (free Lite account)
# 2. Create a watsonx.ai instance
# 3. Create a project in watsonx.ai Studio
# 4. Generate an API key: IBM Cloud → IAM → API Keys
# -----------------------------------------------------------
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model to use.
# Run `node src/test.js` to see which models are available in your project.
# ibm/granite-4-h-small      — IBM Granite 4 (recommended, widely available)
# ibm/granite-3-8b-instruct  — Granite 3 instruct (if provisioned in your project)
GRANITE_MODEL_ID=ibm/granite-4-h-small

# -----------------------------------------------------------
# IBM Cloud IAM
# Used internally to generate Bearer tokens — do not change
# -----------------------------------------------------------
IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token

# -----------------------------------------------------------
# Open-Meteo Weather API (free, no key required)
# https://open-meteo.com/
# -----------------------------------------------------------
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# -----------------------------------------------------------
# OpenStreetMap / Nominatim (free, no key required)
# -----------------------------------------------------------
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# -----------------------------------------------------------
# REST Countries API (free, no key required)
# -----------------------------------------------------------
RESTCOUNTRIES_API_URL=https://restcountries.com/v3.1

# -----------------------------------------------------------
# Exchange Rate API (optional)
# Sign up at https://www.exchangerate-api.com/ for a free key
# -----------------------------------------------------------
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6

# -----------------------------------------------------------
# Application settings
# -----------------------------------------------------------
PORT=3000
NODE_ENV=development
CACHE_TTL=3600

# IBM Granite generation parameters
GRANITE_MAX_TOKENS=1024
GRANITE_TEMPERATURE=0.7
GRANITE_TOP_P=0.9
