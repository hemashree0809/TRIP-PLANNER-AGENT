# ============================================================
#   TRAVEL PLANNER AGENT — Environment Configuration
#   IBM Cloud Lite + IBM Granite (watsonx.ai)
# ============================================================

# -----------------------------------------------------------
# IBM watsonx.ai (Granite LLM)
# Get these from: https://cloud.ibm.com/
#   → IBM Cloud Dashboard → Resource List → watsonx.ai instance
# -----------------------------------------------------------
WATSONX_API_KEY=4jWLM4n-gKEFXAK-3scg6z3N9azjzJwo8zmNKtm_VcIT
WATSONX_PROJECT_ID=d625e762-855a-47d1-93f2-81c28963ad17
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model to use (IBM Granite 13b chat / 3b / 8b instruct)
GRANITE_MODEL_ID=ibm/granite-4-h-small

# -----------------------------------------------------------
# IBM Cloud IAM
# Used for generating Bearer tokens automatically
# -----------------------------------------------------------
IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token

# -----------------------------------------------------------
# Open-Meteo Weather API (Free — no key required)
# https://open-meteo.com/
# -----------------------------------------------------------
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# -----------------------------------------------------------
# OpenStreetMap / Nominatim (Free — no key required)
# Used for map/location data
# -----------------------------------------------------------
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# -----------------------------------------------------------
# REST Countries API (Free — no key required)
# https://restcountries.com/
# -----------------------------------------------------------
RESTCOUNTRIES_API_URL=https://restcountries.com/v3.1

# -----------------------------------------------------------
# Exchange Rate API (Free tier)
# https://www.exchangerate-api.com/ — sign up for free key
# -----------------------------------------------------------
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6

# -----------------------------------------------------------
# Application Settings
# -----------------------------------------------------------
PORT=3000
NODE_ENV=development

# Session / Cache TTL (seconds)
CACHE_TTL=3600

# Max tokens for Granite response
GRANITE_MAX_TOKENS=1024
GRANITE_TEMPERATURE=0.7
GRANITE_TOP_P=0.9
